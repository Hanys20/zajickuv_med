{
  "name": "zajickuv-med",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc",
    "test:contact": "node --test worker/contact.test.mjs worker/contact.runtime.test.mjs worker/email-forward.test.mjs",
    "test:pages": "wrangler pages functions build --outdir .wrangler/contact-pages-build && node --test worker/pages.runtime.test.mjs",
    "check:worker": "tsc -p worker/tsconfig.json",
    "contact:manage": "node scripts/contact-manage.mjs",
    "pages:dev": "wrangler pages dev out",
    "deploy": "next build && wrangler deploy --config wrangler.worker.jsonc"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "wrangler": "^4.112.0"
  }
}
